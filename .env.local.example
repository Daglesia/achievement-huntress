# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=steam-api-key

# Base URL of this app (must match what you register / what Steam redirects back to)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: point at an existing Postgres database to cache game achievement
# schemas there. If left unset, a local SQLite file at ./data/dev.db is
# created and used automatically -- nothing else to configure.
# DATABASE_URL=postgres://user:password@localhost:5432/steam_cache
